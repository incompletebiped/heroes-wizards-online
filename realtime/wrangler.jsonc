{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "heroes-wizards-realtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "LOBBY", "class_name": "Lobby" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Lobby"] }],
  "vars": {
    // Comma-separated origins allowed to call this worker, e.g. "https://heroes-wizards.vercel.app,http://localhost:3000".
    // "*" allows any origin.
    "ALLOWED_ORIGINS": "*"
  }
}
